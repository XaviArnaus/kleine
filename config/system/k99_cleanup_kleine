# This script is intended to be run at shutting down,
#   to clean up any leftover state from a previous run of Kleiune. 
#   It stops the service, clears the state, and restores the cursor.
#
# Meant to be linked to:
#       /etc/rc0.d/K99_cleanup_kleine, so it runs at shutdown.
#       /etc/rc6.d/K99_cleanup_kleine, so it runs at reboot.
sudo systemctl stop kleine
cd /home/xavier/kleine ; /home/xavier/.local/bin/poetry run clear
tput cnorm -T /dev/tty0